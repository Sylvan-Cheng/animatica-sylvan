{
  "schemaVersion": 1,
  "id": "animatica",
  "version": "${version}",

  "name": "Animatica Continuation: Sylvan Edition (Unofficial)",
  "description": "Unofficial Animatica port for Minecraft 26.1.2.",
  "authors": ["FoundationGames", "EthanVisagie"],
  "contributors": ["Sylvan-Cheng (26.1.2 port)"],
  "contact": {
    "homepage": "https://modrinth.com/mod/animatica-continuation",
    "sources": "https://github.com/EthanVisagie/Animatica-Continuation",
    "issues": "https://github.com/EthanVisagie/Animatica-Continuation/issues"
  },

  "license": "LGPL-3.0-or-later",
  "icon": "assets/animatica/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.foundationgames.animatica.Animatica"
    ]
  },
  "mixins": [
    "animatica.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "26.1.2",
    "java": ">=25"
